# Seafile server base URL (no trailing slash). Required — the only required value.
SEAFILE_SERVER_URL=https://seafile.example.com

# --- Credential vault -------------------------------------------------------
# Per-user tokens are registered at runtime via the register_user tool and
# saved to this JSON file (mode 0600). Clients then pass only user_id.
# No tokens need to be fixed here.
SEAFILE_VAULT_PATH=~/.seafile-mcp/vault.json

# --- Optional single-user defaults (env fallback) ---------------------------
# Only needed for single-user stdio use without the vault. Per-call params
# and vault records take precedence over these.
# Account token (full access, all libraries). See README for the curl command.
SEAFILE_ACCOUNT_TOKEN=

# Per-library API tokens as a JSON object mapping library NAME to token.
# Example: SEAFILE_REPO_TOKENS_JSON={"Shared Docs": "abc123...", "Photos": "def456..."}
SEAFILE_REPO_TOKENS_JSON={}

# Auth header scheme: auto (try Token, fall back to Bearer), token, or bearer.
# Seafile < 11 expects "Token"; >= 11 also accepts "Bearer".
SEAFILE_AUTH_SCHEME=auto

# Safety mode: read_only | safe_write (default) | full.
# read_only  — no mutating tools are registered at all.
# safe_write — create/rename/move/copy/upload allowed; deletes are NOT registered.
# full       — additionally registers delete_library and delete_item.
SEAFILE_MCP_MODE=safe_write

# Transport default when --transport is not passed: stdio | streamable-http
SEAFILE_TRANSPORT=stdio
# Host/port for streamable-http transport.
SEAFILE_HOST=127.0.0.1
SEAFILE_PORT=8000
